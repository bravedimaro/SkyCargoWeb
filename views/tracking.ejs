    <style>
      body{font-family:'Montserrat',sans-serif;background:#f4f6fb;color:#0f172a;min-height:100vh}
      .tk-wrap{max-width:880px;margin:0 auto;padding:32px 18px 56px}
      .tk-header{text-align:center;margin-bottom:24px}
      .tk-header img{max-height:64px;width:auto;object-fit:contain;margin-bottom:10px}
      .tk-header h1{font-weight:800;font-size:28px;margin:6px 0 4px;color:#0f172a}
      .tk-header h5{font-weight:500;color:#64748b;font-size:15px;margin:0}
      .tk-card{background:#fff;border:1px solid #e5eaf3;border-radius:18px;padding:28px;box-shadow:0 12px 30px -22px rgba(15,23,42,.18);max-width:560px;margin:0 auto}
      .tk-card .form-label{font-weight:700;color:#334155;font-size:13px;margin-bottom:6px}
      .tk-card .form-control,.tk-card .form-select{padding:12px 14px;border:1.5px solid #dbe3f0;border-radius:10px;font-size:15px}
      .tk-card .btn-primary{background:#2563eb;border:0;font-weight:700;padding:14px;border-radius:10px;width:100%}
      .tk-card .btn-primary:hover{background:#1e3a8a}
      .tk-back{display:block;text-align:center;margin-top:14px;color:#64748b;font-weight:600;font-size:14px;text-decoration:none}
      .tk-back:hover{color:#1e3a8a}
      .tk-error{color:#dc2626;font-size:13px;margin-top:6px;min-height:18px}
      .tk-result{margin-top:24px;background:#fff;border:1px solid #e5eaf3;border-radius:18px;overflow:hidden}
      .tk-result-head{padding:18px 22px;background:linear-gradient(135deg,#1e3a8a,#2563eb);color:#fff;font-weight:700;font-size:18px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
      .tk-result-head .badge-time{background:rgba(255,255,255,.18);font-weight:600;font-size:12px;padding:6px 12px;border-radius:999px}
      .tk-party{padding:20px 22px;border-bottom:1px solid #eef2f7}
      .tk-party:last-child{border-bottom:0}
      .tk-party h6{font-size:11px;text-transform:uppercase;letter-spacing:1.2px;color:#64748b;margin:0 0 12px;font-weight:700}
      .tk-info{display:flex;gap:12px;margin-bottom:12px}
      .tk-info i{color:#2563eb;width:18px;margin-top:4px;flex-shrink:0}
      .tk-info .lbl{font-size:12px;color:#94a3b8;display:block}
      .tk-info .val{font-size:15px;color:#0f172a;font-weight:600}
      .tk-timeline{position:relative;padding-left:24px;margin-top:8px}
      .tk-timeline:before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:2px;background:#dbe3f0}
      .tk-tl-item{position:relative;padding-bottom:18px}
      .tk-tl-item:before{content:"";position:absolute;left:-22px;top:6px;width:14px;height:14px;border-radius:50%;background:#2563eb;border:3px solid #fff;box-shadow:0 0 0 2px #dbe3f0}
      .tk-tl-item .tl-status{font-weight:700;color:#0f172a;font-size:15px}
      .tk-tl-item .tl-where{color:#64748b;font-size:13px;margin-top:2px}
      .tk-tl-item .tl-when{color:#94a3b8;font-size:12px;margin-top:2px}

      @media(max-width:640px){
        .tk-wrap{padding:18px 12px 40px}
        .tk-header h1{font-size:22px}
        .tk-card{padding:20px 16px;border-radius:14px}
        .tk-result{border-radius:14px}
        .tk-result-head{padding:14px 16px;font-size:16px}
        .tk-party{padding:16px}
        .tk-info .val{font-size:14px}
      }
    </style>
